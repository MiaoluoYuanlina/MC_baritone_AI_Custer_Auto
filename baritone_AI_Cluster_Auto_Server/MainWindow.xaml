<Window x:Class="BaritoneClusterServer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Baritone AI Cluster" Height="680" Width="1040" MinHeight="500" MinWidth="820">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="220"/><ColumnDefinition Width="16"/>
        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="180"/><ColumnDefinition Width="16"/>
        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock VerticalAlignment="Center" Text="DeepSeek API Key"/>
      <PasswordBox x:Name="ApiKeyBox" Grid.Column="1" Margin="8,0,0,0"/>
      <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="模型"/>
      <TextBox x:Name="ModelBox" Grid.Column="4" Margin="8,0,0,0" Text="deepseek-chat"/>
      <Button Grid.Column="6" Content="打开集群地图" Padding="12,4" Click="OpenMapButton_Click"/>
      <TextBlock x:Name="ConnectionText" Grid.Column="8" VerticalAlignment="Center" Foreground="DarkGreen" Text="正在监听 25570"/>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <GroupBox Header="游戏实例（双击详情，右键设置主要玩家）">
        <ListBox x:Name="InstanceList" Margin="8" DisplayMemberPath="Display" MouseDoubleClick="InstanceList_MouseDoubleClick" PreviewMouseRightButtonDown="InstanceList_PreviewMouseRightButtonDown">
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="设为主要玩家（默认禁止 AI）" Click="SetPrimaryPlayer_Click"/>
              <Separator/>
              <MenuItem Header="允许 AI 控制主要玩家" Click="AllowPrimaryAi_Click"/>
              <MenuItem Header="禁止 AI 控制主要玩家" Click="ProtectPrimaryFromAi_Click"/>
              <Separator/>
              <MenuItem Header="结束当前附身" Click="StopPossession_Click"/>
            </ContextMenu>
          </ListBox.ContextMenu>
        </ListBox>
      </GroupBox>
      <GroupBox Grid.Column="2" Header="用户 / AI 对话"><TextBox x:Name="ChatLog" Margin="8" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/></GroupBox>
    </Grid>

    <Grid Grid.Row="2" Margin="0,12,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="105"/><ColumnDefinition Width="105"/><ColumnDefinition Width="115"/></Grid.ColumnDefinitions>
      <TextBox x:Name="PromptBox" MinHeight="64" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
      <Button x:Name="SendButton" Grid.Column="1" Margin="10,0,0,0" Content="发送对话" Click="SendButton_Click"/>
      <Button x:Name="InterruptButton" Grid.Column="2" Margin="10,0,0,0" Content="中断" IsEnabled="False" Click="InterruptButton_Click"/>
      <Button x:Name="ClearContextButton" Grid.Column="3" Margin="10,0,0,0" Content="清空上下文" Click="ClearContextButton_Click"/>
    </Grid>
  </Grid>
</Window>
